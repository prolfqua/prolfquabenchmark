# Benchmark pipeline of prolfquabenchmark: prepare each dataset once, fit every method to it, score the contrasts.
# Run from the package root:
#   uv run snakemake -s workflow/Snakefile --configfile config/config.yaml -j 4
# The config names every dataset and method (config/config.yaml). The scripts in workflow/scripts use the installed
# packages; each rule's `params` carry the version and build time of the packages it uses, so reinstalling a package
# reruns only the jobs that depend on it.
# With --config release=<version> (make score-history-release), prepare, the prolfqua fits and the step timings use
# the prolfqua and prolfquapp in results/releases/<version>/lib (inst/scripts/install_release.sh): only the prolfqua
# methods whose facade that release has, results and logs under releases/<version>, no export.

import os
import subprocess

DATASETS = config["datasets"]
METHODS = config["methods"]
CONFIG_FILE = "config/config.yaml"
RELEASE = config.get("release")
RESULTS = f"results/releases/{RELEASE}" if RELEASE else "results"
LOGS = f"logs/releases/{RELEASE}" if RELEASE else "logs"
RELEASE_LIB = os.path.abspath(f"{RESULTS}/lib")
# Prefix of the shell commands that run with the release's prolfqua
R_LIBS = f"R_LIBS={RELEASE_LIB} " if RELEASE else ""


def run_r(code, *args):
    """Output of an R expression, with the release's library first when RELEASE is set."""
    env = {**os.environ, "R_LIBS": RELEASE_LIB} if RELEASE else None
    return subprocess.run(["Rscript", "-e", code, *args], capture_output=True, text=True, check=True, env=env).stdout


def installed_packages(packages):
    """Version and build time of each package ('absent' if not installed), read once per run."""
    code = (
        "for (p in commandArgs(TRUE)) {"
        " d <- suppressWarnings(utils::packageDescription(p));"
        " cat(p, if (is.list(d)) paste(d$Version, d$Built) else 'absent', sep = '\\t'); cat('\\n') }"
    )
    out = run_r(code, *packages)
    return dict(line.split("\t", 1) for line in out.strip().splitlines())


if RELEASE:
    FACADES = set(run_r("cat(names(prolfqua::list_facades()), sep = '\\n')").split())
    METHODS = {m: s for m, s in METHODS.items() if s["tool"] == "prolfqua" and s["facade"] in FACADES}


TOOL_PACKAGES = {"prolfqua": ["prolfqua"]}
PACKAGES = installed_packages(
    sorted({"prolfqua", "prolfquabenchmark"}
           | {p for spec in METHODS.values() for p in TOOL_PACKAGES.get(spec["tool"], [spec["tool"]])})
)


def method_packages(method):
    spec = METHODS[method]
    names = TOOL_PACKAGES.get(spec["tool"], [spec["tool"]]) + ["prolfquabenchmark"]
    return {name: PACKAGES[name] for name in names}


# Every method on every dataset that provides all of its inputs
JOBS = [
    (dataset, method)
    for method, spec in METHODS.items()
    for dataset, dataset_spec in DATASETS.items()
    if set(spec["input"]) <= set(dataset_spec["inputs"])
]
SCORES = [f"{RESULTS}/scores/{dataset}/{method}.tsv" for dataset, method in JOBS]
PROLFQUA_VERSION = PACKAGES["prolfqua"].split(" ")[0]
# Datasets with peptides and proteins: the peptide consistency weights (vignette Peptide_consistency_weights)
CONSISTENCY_DATASETS = [d for d, spec in DATASETS.items() if {"peptides", "proteins"} <= set(spec["inputs"])]

wildcard_constraints:
    dataset="|".join(DATASETS),
    method="|".join(METHODS),


rule all:
    input:
        SCORES,
        [] if RELEASE else "inst/extdata/benchmark_scores.tsv",
        [] if RELEASE else "inst/extdata/peptide_consistency_scores.tsv",


rule prepare:
    input:
        script=lambda w: f"workflow/scripts/{DATASETS[w.dataset]['prepare']}",
        common="workflow/scripts/common.R",
    output:
        directory(f"{RESULTS}/prepared/{{dataset}}"),
    params:
        packages=lambda w: {"prolfqua": PACKAGES["prolfqua"]},
    log:
        f"{LOGS}/prepare_{{dataset}}.log",
    shell:
        f"{R_LIBS}Rscript {{input.script}} {RESULTS}/prepared/{{wildcards.dataset}} > {{log}} 2>&1"


def prepared_input(wildcards):
    """The prepared dataset, for methods fitted to its peptides, proteins or protein table."""
    needs_prepared = {"peptides", "proteins", "protein_table"} & set(METHODS[wildcards.method]["input"])
    return f"{RESULTS}/prepared/{wildcards.dataset}" if needs_prepared else []


rule fit:
    input:
        script=lambda w: f"workflow/scripts/{METHODS[w.method]['script']}",
        common="workflow/scripts/common.R",
        config=CONFIG_FILE,
        prepared=prepared_input,
    output:
        contrasts=f"{RESULTS}/contrasts/{{dataset}}/{{method}}/contrasts.tsv",
        metadata=f"{RESULTS}/contrasts/{{dataset}}/{{method}}/metadata.yaml",
    params:
        packages=lambda w: method_packages(w.method),
    benchmark:
        f"{RESULTS}/benchmarks/{{dataset}}/{{method}}.tsv"
    log:
        f"{LOGS}/fit_{{dataset}}_{{method}}.log",
    shell:
        f"{R_LIBS}Rscript {{input.script}} {{input.config}} {{wildcards.dataset}} {{wildcards.method}} "
        f"{RESULTS}/prepared/{{wildcards.dataset}} {RESULTS}/contrasts/{{wildcards.dataset}}/{{wildcards.method}} "
        "> {log} 2>&1"


rule score:
    input:
        script="workflow/scripts/score.R",
        common="workflow/scripts/common.R",
        contrasts=f"{RESULTS}/contrasts/{{dataset}}/{{method}}/contrasts.tsv",
        metadata=f"{RESULTS}/contrasts/{{dataset}}/{{method}}/metadata.yaml",
    output:
        scores=f"{RESULTS}/scores/{{dataset}}/{{method}}.tsv",
        curves=f"{RESULTS}/curves/{{dataset}}/{{method}}.tsv",
    params:
        packages=lambda w: {"prolfquabenchmark": PACKAGES["prolfquabenchmark"]},
    log:
        f"{LOGS}/score_{{dataset}}_{{method}}.log",
    shell:
        f"Rscript {{input.script}} {RESULTS}/contrasts/{{wildcards.dataset}}/{{wildcards.method}} "
        "{output.scores} {output.curves} > {log} 2>&1"


# Scores every method of a dataset that tests all the pairs of a Pareto-front method on those pairs
rule score_same_pairs:
    input:
        script="workflow/scripts/score_same_pairs.R",
        common="workflow/scripts/common.R",
        contrasts=lambda w: [f"{RESULTS}/contrasts/{w.dataset}/{m}/contrasts.tsv" for d, m in JOBS if d == w.dataset],
        scores=lambda w: [f"{RESULTS}/scores/{w.dataset}/{m}.tsv" for d, m in JOBS if d == w.dataset],
    output:
        f"{RESULTS}/same_pairs/{{dataset}}.tsv",
    params:
        packages=lambda w: {name: PACKAGES[name] for name in ["prolfqua", "prolfquabenchmark"]},
        methods=lambda w: " ".join(m for d, m in JOBS if d == w.dataset),
    log:
        f"{LOGS}/score_same_pairs_{{dataset}}.log",
    shell:
        "Rscript {input.script} {wildcards.dataset} {output} {params.methods} > {log} 2>&1"


rule export:
    input:
        script="workflow/scripts/export.R",
        common="workflow/scripts/common.R",
        config=CONFIG_FILE,
        scores=SCORES,
        curves=[f"{RESULTS}/curves/{dataset}/{method}.tsv" for dataset, method in JOBS],
        metadata=[f"{RESULTS}/contrasts/{dataset}/{method}/metadata.yaml" for dataset, method in JOBS],
        fit_times=[f"{RESULTS}/benchmarks/{dataset}/{method}.tsv" for dataset, method in JOBS],
        same_pairs=[f"{RESULTS}/same_pairs/{dataset}.tsv" for dataset in sorted({d for d, m in JOBS})],
    output:
        scores="inst/extdata/benchmark_scores.tsv",
        curves="inst/extdata/benchmark_curves.tsv",
        methods="inst/extdata/benchmark_methods.tsv",
        datasets="inst/extdata/benchmark_datasets.tsv",
        preprocessing="inst/extdata/benchmark_preprocessing.tsv",
        same_pairs="inst/extdata/benchmark_same_pairs.tsv",
    log:
        "logs/export.log",
    shell:
        "Rscript {input.script} {input.config} inst/extdata {input.scores} > {log} 2>&1"


# Weights of the protein abundances from the consistency of their peptides, one dataset per job: the lm, limma, deqms
# and rlm facades fitted with each weight variant and scored
rule peptide_consistency:
    input:
        script="workflow/scripts/peptide_consistency_weights.R",
        common="workflow/scripts/common.R",
        config=CONFIG_FILE,
        prepared=f"{RESULTS}/prepared/{{dataset}}",
    output:
        scores=f"{RESULTS}/peptide_consistency/{{dataset}}/scores.tsv",
        priors=f"{RESULTS}/peptide_consistency/{{dataset}}/priors.tsv",
    params:
        packages=lambda w: {name: PACKAGES[name] for name in ["prolfqua", "prolfquabenchmark"]},
    log:
        f"{LOGS}/peptide_consistency_{{dataset}}.log",
    shell:
        f"Rscript {{input.script}} {{input.config}} {{wildcards.dataset}} {{input.prepared}} "
        f"{RESULTS}/peptide_consistency/{{wildcards.dataset}} > {{log}} 2>&1"


rule export_peptide_consistency:
    input:
        script="workflow/scripts/export_peptide_consistency.R",
        common="workflow/scripts/common.R",
        scores=[f"{RESULTS}/peptide_consistency/{dataset}/scores.tsv" for dataset in CONSISTENCY_DATASETS],
        priors=[f"{RESULTS}/peptide_consistency/{dataset}/priors.tsv" for dataset in CONSISTENCY_DATASETS],
    output:
        scores="inst/extdata/peptide_consistency_scores.tsv",
        priors="inst/extdata/peptide_consistency_priors.tsv",
    log:
        "logs/export_peptide_consistency.log",
    shell:
        "Rscript {input.script} inst/extdata {input.scores} > {log} 2>&1"


rule timing_input:
    input:
        script="workflow/scripts/timing_input.R",
    output:
        f"{RESULTS}/timing/input.rds",
    log:
        f"{LOGS}/timing_input.log",
    shell:
        "Rscript {input.script} {output} > {log} 2>&1"


# Runs alone (all cores reserved), so the step timings are not disturbed by other jobs
rule time_steps:
    input:
        script="workflow/scripts/time_prolfqua_steps.R",
        data=f"{RESULTS}/timing/input.rds",
    output:
        f"{RESULTS}/timing/history_rows.tsv",
    params:
        packages=lambda w: {"prolfqua": PACKAGES["prolfqua"]},
    threads: workflow.cores
    log:
        f"{LOGS}/time_steps.log",
    shell:
        f"{R_LIBS}Rscript {{input.script}} {{input.data}} {RESULTS}/timing > {{log}} 2>&1"


# Appends the scores and step timings of the prolfqua the fits used to inst/extdata/score_history.tsv, dated today
# or, for a release, with --config release_date=<commit date>; refuses a recorded version unless run with
# --config replace=true (make score-history REPLACE=1)
rule score_history:
    input:
        script="workflow/scripts/update_score_history.R",
        common="workflow/scripts/common.R",
        scores=SCORES,
        timing=f"{RESULTS}/timing/history_rows.tsv",
    output:
        touch(f"{RESULTS}/history/prolfqua_{PROLFQUA_VERSION}.done"),
    params:
        replace=config.get("replace", False),
        version=PROLFQUA_VERSION,
        date=config.get("release_date", "today"),
    log:
        f"{LOGS}/score_history.log",
    shell:
        "Rscript {input.script} inst/extdata/score_history.tsv {input.timing} {params.replace} {params.version} "
        "{params.date} {input.scores} > {log} 2>&1"
